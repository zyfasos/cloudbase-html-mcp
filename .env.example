CLOUDBASE_ENV_ID=your-env-id
CLOUDBASE_REGION=ap-shanghai
# Server-side environment API Key (api_key), not a Publishable Key or CAM key pair.
CLOUDBASE_API_KEY=your-environment-api-key
# Optional: an HTTPS custom domain already bound to this hosting environment.
# CLOUDBASE_PUBLIC_BASE_URL=https://your-domain.example
# Optional: absolute directory outside any Git repository. Default: ~/.config/cloudbase-html-mcp/pages
# Set to off to disable local page registration.
# CLOUDBASE_REGISTRY_DIR=/absolute/private/cloudbase-html-pages
